[Plymouth Theme]
Name=NealOS
Description=NealOS boot splash, generated from the active palette
ModuleName=two-step

[two-step]
Font=Red Hat Display 12
TitleFont=Red Hat Display 30
ImageDir=${IMAGEDIR}
HorizontalAlignment=.5
VerticalAlignment=.5
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.75
Transition=none
TransitionDuration=0.0
BackgroundStartColor=${PLY_SURFACE}
BackgroundEndColor=${PLY_SURFACE}
ProgressBarBackgroundColor=${PLY_OUTLINE}
ProgressBarForegroundColor=${PLY_PRIMARY}
UseProgressBar=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false