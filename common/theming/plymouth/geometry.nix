# Mark geometry, drawn on a 400x400 canvas. Everything else scales this.
{
  canvas = 400;
  xLeft = 130; # left vertical
  xRight = 270; # right vertical
  yTop = 100;
  yBottom = 220;
  strokeWidth = 24;
  wordY = 300; # wordmark baseline
  wordSize = 40;
  wordTracking = 12;
  splashScale = 1.4;
  splashX = 1160;
  splashY = 260;
}
