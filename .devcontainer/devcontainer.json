{
  "name": "nealbox-nealos",
  "image": "ghcr.io/nvveen/nealbox:latest",
  "runArgs": [
    "--hostname=nealbox-nealos",
    "--name=nealbox-${localWorkspaceFolderBasename}",
    "--restart=unless-stopped"
  ],
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "davidanson.vscode-markdownlint"
      ]
    }
  }
}